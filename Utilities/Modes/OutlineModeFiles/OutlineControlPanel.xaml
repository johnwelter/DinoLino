<UserControl x:Class="DinoLino.Utilities.Modes.OutlineControlPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DinoLino.Utilities.Modes">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:IntEqualityConverter x:Key="EqualityConverter"/>
        <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
    </UserControl.Resources>

    <StackPanel Margin="10,10,10,0">

        <!-- Draw Outline tool -->
        <RadioButton Content="Automated Outline"
                     GroupName="OutlineTool"
                     IsChecked="{Binding DrawOutlineMode, Mode=TwoWay}"
                     MinHeight="26"/>

        <StackPanel Visibility="{Binding DrawOutlineMode, Converter={StaticResource BoolToVis}}">
            <CheckBox Content="Use Watershed"
                  IsChecked="{Binding UseWatershed, Mode=TwoWay}"
                  Margin="0,6,0,0"
                  ToolTip="More accurate boundaries on complex images, slightly slower"/>

            <CheckBox Content="Multi-Click"
                IsChecked="{Binding MultiClickOutline, Mode=TwoWay}"
                Margin="0,6,0,0"
                ToolTip="First click shows a candidate outline. Click inside to confirm, or outside to expand."/>

            <StackPanel Visibility="{Binding UseWatershed, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Boundary Sensitivity:" FontWeight="Bold" Margin="0,8,0,0"/>
                <TextBlock TextWrapping="Wrap" Foreground="Gray"
                     Text="Pre-blur reduces noise. Lower sensitivity follows broader boundaries."
                     Margin="0,0,0,4"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="Off"
                         GroupName="WatershedBlur"
                         IsChecked="{Binding WatershedBlurLevel,
                             Converter={StaticResource EqualityConverter},
                             ConverterParameter=0, Mode=TwoWay}"
                         Margin="0,0,8,0"/>
                    <RadioButton Content="Low"
                         GroupName="WatershedBlur"
                         IsChecked="{Binding WatershedBlurLevel,
                             Converter={StaticResource EqualityConverter},
                             ConverterParameter=1, Mode=TwoWay}"
                         Margin="0,0,8,0"/>
                    <RadioButton Content="High"
                         GroupName="WatershedBlur"
                         IsChecked="{Binding WatershedBlurLevel,
                             Converter={StaticResource EqualityConverter},
                             ConverterParameter=2, Mode=TwoWay}"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Visibility="{Binding UseWatershed, Converter={StaticResource InverseBoolToVis}}">
                <TextBlock Text="Fill Sensitivity:" FontWeight="Bold" Margin="0,8,0,0"/>
                <TextBlock TextWrapping="Wrap" Foreground="Gray"
                     Text="How aggressively the fill expands from the clicked point."
                     Margin="0,0,0,2"/>
                <Slider Minimum="5" Maximum="150" Value="{Binding FillSensitivity}"
                  TickFrequency="5" IsSnapToTickEnabled="True" Margin="0,2,0,2"/>
                <TextBlock>
                    <TextBlock.Text>
                        <Binding Path="FillSensitivity" StringFormat="{}Value: {0:F0}"/>
                    </TextBlock.Text>
                </TextBlock>
            </StackPanel>
        </StackPanel>

        <!-- Draw by Hand tool -->
        <RadioButton Content="Draw by Hand"
             GroupName="OutlineTool"
             IsChecked="{Binding HandDrawMode, Mode=TwoWay}"
             MinHeight="26"
             Margin="0,8,0,0"
             ToolTip="Hold and drag to draw an outline freehand. It closes when the stroke crosses itself."/>

        <StackPanel Visibility="{Binding HandDrawMode, Converter={StaticResource BoolToVis}}">
            <TextBlock TextWrapping="Wrap" Foreground="Gray"
               Text="Hold the left button and drag to draw. The outline closes automatically when your stroke crosses itself; leftover tails are removed."
               Margin="0,6,0,4"/>
        </StackPanel>

        <!-- Erase Outline tool.
             Tool PARAMETERS now live on the tool object: the mode is still the
             DataContext, so paths go through the Erase property. -->
        <RadioButton Content="Erase Outline"
                     GroupName="OutlineTool"
                     IsChecked="{Binding EraseOutlineMode, Mode=TwoWay}"
                     MinHeight="26"
                     Margin="0,8,0,0"
                     ToolTip="Click and drag over the outline"/>

        <StackPanel Visibility="{Binding EraseOutlineMode, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Erase Brush Size:" FontWeight="Bold" Margin="0,8,0,0"/>
            <Slider Minimum="5" Maximum="100"
                    Value="{Binding Erase.BrushRadius, Mode=TwoWay}"
                    TickFrequency="5"
                    IsSnapToTickEnabled="True"
                    Margin="0,2,0,2"/>
            <TextBlock Text="{Binding Erase.BrushRadius, StringFormat={}{0:F0} px}"
                       Foreground="Gray" Margin="0,0,0,4"/>
        </StackPanel>

        <!-- Push Outline tool: inverse of Erase — expands the outline outward. -->
        <RadioButton Content="Push Outline"
             GroupName="OutlineTool"
             IsChecked="{Binding PushOutlineMode, Mode=TwoWay}"
             MinHeight="26"
             Margin="0,8,0,0"
             ToolTip="Click and drag from inside the outline outward to expand it — or hold Ctrl and move the cursor."/>

        <StackPanel Visibility="{Binding PushOutlineMode, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Push Brush Size:" FontWeight="Bold" Margin="0,8,0,0"/>
            <Slider Minimum="5" Maximum="100"
            Value="{Binding Push.BrushRadius, Mode=TwoWay}"
            TickFrequency="5"
            IsSnapToTickEnabled="True"
            Margin="0,2,0,2"/>
            <TextBlock Text="{Binding Push.BrushRadius, StringFormat={}{0:F0} px}"
               Foreground="Gray" Margin="0,0,0,4"/>
        </StackPanel>

        <!-- Smooth Outline tool -->
        <RadioButton Content="Smooth Outline"
                     GroupName="OutlineTool"
                     IsChecked="{Binding SmoothOutlineMode, Mode=TwoWay}"
                     MinHeight="26"
                     Margin="0,8,0,0"/>

        <StackPanel Visibility="{Binding SmoothOutlineMode, Converter={StaticResource BoolToVis}}">
            <!-- NEW UI: the SmoothTool has supported Global vs Local scope in
                 code for a while, but the panel never exposed the choice, so
                 Local smoothing (the sanding brush) was unreachable from here. -->
            <TextBlock Text="Scope:" FontWeight="Bold" Margin="0,8,0,0"/>
            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                <RadioButton Content="Global"
                             GroupName="SmoothScope"
                             IsChecked="{Binding Smooth.IsGlobalScope, Mode=TwoWay}"
                             Margin="0,0,10,0"
                             ToolTip="The slider smooths the whole perimeter live."/>
                <RadioButton Content="Local"
                             GroupName="SmoothScope"
                             IsChecked="{Binding Smooth.IsLocalScope, Mode=TwoWay}"
                             ToolTip="The cursor becomes a sanding brush — click and drag along the outline to smooth just that section."/>
            </StackPanel>

            <TextBlock Text="Smooth Strength:" FontWeight="Bold" Margin="0,8,0,0"/>
            <Slider Minimum="0" Maximum="20"
                    Value="{Binding Smooth.Strength, Mode=TwoWay}"
                    TickFrequency="1"
                    IsSnapToTickEnabled="True"
                    Margin="0,2,0,2"/>
            <TextBlock Text="{Binding Smooth.Strength, StringFormat={}{0:F0} passes}"
                       Foreground="Gray" Margin="0,0,0,4"/>

            <StackPanel Visibility="{Binding Smooth.IsLocalScope, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Brush Size:" FontWeight="Bold" Margin="0,4,0,0"/>
                <Slider Minimum="5" Maximum="100"
                        Value="{Binding Smooth.BrushRadius, Mode=TwoWay}"
                        TickFrequency="5"
                        IsSnapToTickEnabled="True"
                        Margin="0,2,0,2"/>
                <TextBlock Text="{Binding Smooth.BrushRadius, StringFormat={}{0:F0} px}"
                           Foreground="Gray" Margin="0,0,0,4"/>
            </StackPanel>
        </StackPanel>

        <!-- Generate Metadata.
             The Checked/Unchecked handlers trigger GenerateMetadata /
             ClearEFDPreview — the OutlineMetadataMode SETTER no longer runs
             work as a side effect of the two-way binding.
             The Preview handlers veto selection while a hand-drawn stroke is
             still open: WPF unchecks the rest of the radio group (destroying
             the stroke via the hand-draw binding) BEFORE raising Checked, so
             a veto inside Checked can never fire — it must intercept the
             input before any group state changes. -->
        <RadioButton Content="Generate Metadata"
             x:Name="MetadataRadio"
             GroupName="OutlineTool"
             IsChecked="{Binding OutlineMetadataMode, Mode=TwoWay}"
             Checked="MetadataRadio_Checked"
             Unchecked="MetadataRadio_Unchecked"
             PreviewMouseLeftButtonDown="MetadataRadio_PreviewMouseDown"
             PreviewKeyDown="MetadataRadio_PreviewKeyDown"
             MinHeight="26"
             Margin="0,8,0,0"/>

        <StackPanel Visibility="{Binding OutlineMetadataMode, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Shape Metrics:" FontWeight="Bold" Margin="0,0,0,4"/>

            <!-- Compact summary rows -->
            <Grid Margin="0,2,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Aspect Ratio:" Foreground="Gray"/>
                <TextBlock Grid.Column="1" Text="{Binding AspectRatioResult, StringFormat={}{0:F3}}" HorizontalAlignment="Right"/>
            </Grid>

            <!-- The scaled rows bind NUMBERS + IsScaleCalibrated; the view owns
                 the formatting and the uncalibrated wording (previously the
                 mode baked "Error: Unscaled" into the value string). -->
            <Grid Margin="0,2,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Perimeter:" Foreground="Gray"/>
                <TextBlock Grid.Column="1" HorizontalAlignment="Right"
                           Visibility="{Binding IsScaleCalibrated, Converter={StaticResource BoolToVis}}">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="{}{0:F2} {1}">
                            <Binding Path="PerimeterScaledValue"/>
                            <Binding Path="ScaleUnit"/>
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
                <TextBlock Grid.Column="1" Text="Uncalibrated" Foreground="#C0392B" HorizontalAlignment="Right"
                           ToolTip="Use the Scale tool to calibrate, then regenerate metadata."
                           Visibility="{Binding IsScaleCalibrated, Converter={StaticResource InverseBoolToVis}}"/>
            </Grid>

            <Grid Margin="0,2,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Area:" Foreground="Gray"/>
                <TextBlock Grid.Column="1" HorizontalAlignment="Right"
                           Visibility="{Binding IsScaleCalibrated, Converter={StaticResource BoolToVis}}">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="{}{0:F2} {1}²">
                            <Binding Path="AreaScaledValue"/>
                            <Binding Path="ScaleUnit"/>
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
                <TextBlock Grid.Column="1" Text="Uncalibrated" Foreground="#C0392B" HorizontalAlignment="Right"
                           ToolTip="Use the Scale tool to calibrate, then regenerate metadata."
                           Visibility="{Binding IsScaleCalibrated, Converter={StaticResource InverseBoolToVis}}"/>
            </Grid>

            <Grid Margin="0,2,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Perimeter / Area:" Foreground="Gray"/>
                <TextBlock Grid.Column="1" Text="{Binding PerimeterAreaRatioResult, StringFormat={}{0:F4}}"
                   HorizontalAlignment="Right"/>
            </Grid>

            <Grid Margin="0,2,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Circularity:" Foreground="Gray"/>
                <TextBlock Grid.Column="1" Text="{Binding CircularityResult, StringFormat={}{0:F4}}" HorizontalAlignment="Right"/>
            </Grid>

            <Grid Margin="0,2,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Solidity:" Foreground="Gray"/>
                <TextBlock Grid.Column="1" Text="{Binding SolidityResult, StringFormat={}{0:F4}}" HorizontalAlignment="Right"/>
            </Grid>

            <Grid Margin="0,2,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Turn. Angles / Length:" Foreground="Gray"/>
                <TextBlock Grid.Column="1" Text="{Binding TurningAngleLengthResult, StringFormat={}{0:F4}}" HorizontalAlignment="Right"/>
            </Grid>

            <!-- EFD Harmonics and Contour Points moved into the Elliptic
                 Fourier Analysis window (button below) so every EFA control,
                 plot, and readout lives in one place. -->

            <!-- normalization caveat: only visible when set -->
            <TextBlock Text="{Binding NormalizationWarning}"
                       Foreground="#C0392B" TextWrapping="Wrap"
                       Margin="0,6,0,0"
                       Visibility="{Binding HasNormalizationWarning, Converter={StaticResource BoolToVis}}"/>

            <!-- EFD detail link -->
            <Button Content="Elliptic Fourier Analysis"
            HorizontalAlignment="Left"
            Background="Transparent"
            BorderThickness="0"
            Foreground="{DynamicResource {x:Static SystemColors.HotTrackBrushKey}}"
            Cursor="Hand"
            Padding="0"
            Click="ShowEFDDetails_Click"/>
        </StackPanel>
    </StackPanel>
</UserControl>
