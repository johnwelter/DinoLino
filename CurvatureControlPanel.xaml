<UserControl x:Class="DinoLino.Utilities.Modes.CurvatureControlPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="200">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style TargetType="Label">
            <Setter Property="Padding" Value="0,1,0,1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="CheckBoxRadioButton" TargetType="RadioButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <BulletDecorator Background="Transparent">
                            <BulletDecorator.Bullet>
                                <Border Width="13" Height="13"
                                        BorderThickness="1"
                                        SnapsToDevicePixels="True"
                                        BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                                        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
                                    <Path x:Name="CheckMark"
                                          Margin="1"
                                          SnapsToDevicePixels="False"
                                          Data="M 0,4 L 3,7 L 8,0"
                                          Stroke="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"
                                          StrokeThickness="2"
                                          Visibility="Collapsed"/>
                                </Border>
                            </BulletDecorator.Bullet>
                            <ContentPresenter Margin="4,0,0,0"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </BulletDecorator>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="CheckMark"
                                        Property="Stroke"
                                        Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel x:Name="UI_CurvatureOutputs" Margin="10,10,10,0">
        <RadioButton Content="Circular Arc"
                     GroupName="Curve"
                     Checked="CircularArc_Checked"
                     MinHeight="25"
                     FontWeight="Bold"/>

        <StackPanel Visibility="{Binding IsCircularArcSelected, Converter={StaticResource BoolToVis}}"
                    Margin="0,6,0,0">
            <Label Content="Output:" FontWeight="Bold" Margin="5,0,0,4"/>

            <Grid Margin="0,0,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto" MinWidth="42"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MinWidth="42"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Grid.Column="0" Content="Central Angle:" Margin="5,0,8,4"/>
                <Label Grid.Row="0" Grid.Column="1" Content="{Binding CentralAngleResult}" HorizontalContentAlignment="Left" Margin="0,0,0,4"/>
                <Label Grid.Row="0" Grid.Column="2" Content="Avg" Foreground="Gray" Margin="6,0,4,4"/>
                <Label Grid.Row="0" Grid.Column="3" Content="{Binding AvgCentralAngleResult}" Margin="0,0,0,4"/>

                <Label Grid.Row="1" Grid.Column="0" Content="Chord-Arc Ratio:" Margin="5,0,8,4"/>
                <Label Grid.Row="1" Grid.Column="1" Content="{Binding ChordArcRatioResult}" HorizontalContentAlignment="Left" Margin="0,0,0,4"/>
                <Label Grid.Row="1" Grid.Column="2" Content="Avg" Foreground="Gray" Margin="6,0,4,4"/>
                <Label Grid.Row="1" Grid.Column="3" Content="{Binding AvgChordArcRatioResult}" Margin="0,0,0,4"/>

                <Label Grid.Row="2" Grid.Column="0" Content="Rise-Span Ratio:" Margin="5,0,8,0"/>
                <Label Grid.Row="2" Grid.Column="1" Content="{Binding AspectRatioResult}" HorizontalContentAlignment="Left"/>
                <Label Grid.Row="2" Grid.Column="2" Content="Avg" Foreground="Gray" Margin="6,0,4,0"/>
                <Label Grid.Row="2" Grid.Column="3" Content="{Binding AvgAspectRatioResult}"/>
            </Grid>
        </StackPanel>

        <RadioButton Content="Parabolic Arc"
                     GroupName="Curve"
                     Checked="ParabolicArc_Checked"
                     MinHeight="25"
                     FontWeight="Bold"
                     Margin="0,8,0,0"/>

        <StackPanel Visibility="{Binding IsParabolicArcSelected, Converter={StaticResource BoolToVis}}"
                    Margin="0,6,0,0">
            <Label Content="Output:" FontWeight="Bold" Margin="5,0,0,2"/>
            <Label Content="{Binding XYFunctionResult}" Margin="10,0,0,4"/>

            <Grid Margin="0,0,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto" MinWidth="42"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MinWidth="42"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Grid.Column="0" Content="Chord-Arc Ratio:" Margin="5,0,8,4"/>
                <Label Grid.Row="0" Grid.Column="1" Content="{Binding PChordArcRatioResult}" HorizontalContentAlignment="Left" Margin="0,0,0,4"/>
                <Label Grid.Row="0" Grid.Column="2" Content="Avg" Foreground="Gray" Margin="6,0,4,4"/>
                <Label Grid.Row="0" Grid.Column="3" Content="{Binding AvgPChordArcRatioResult}" Margin="0,0,0,4"/>

                <Label Grid.Row="1" Grid.Column="0" Content="Rise-Span Ratio:" Margin="5,0,8,4"/>
                <Label Grid.Row="1" Grid.Column="1" Content="{Binding RiseSpanRatioResult}" HorizontalContentAlignment="Left" Margin="0,0,0,4"/>
                <Label Grid.Row="1" Grid.Column="2" Content="Avg" Foreground="Gray" Margin="6,0,4,4"/>
                <Label Grid.Row="1" Grid.Column="3" Content="{Binding AvgRiseSpanRatioResult}" Margin="0,0,0,4"/>

                <Label Grid.Row="2" Grid.Column="0" Content="Vertex Curv.:" Margin="5,0,8,0"/>
                <Label Grid.Row="2" Grid.Column="1" Content="{Binding VertexCurvatureResult}" HorizontalContentAlignment="Left"/>
                <Label Grid.Row="2" Grid.Column="2" Content="Avg" Foreground="Gray" Margin="6,0,4,0"/>
                <Label Grid.Row="2" Grid.Column="3" Content="{Binding AvgVertexCurvatureResult}"/>
            </Grid>
        </StackPanel>

        <RadioButton Content="n-Point Spline"
                     GroupName="Curve"
                     Checked="NPointSpline_Checked"
                     MinHeight="25"
                     FontWeight="Bold"
                     Margin="0,8,0,0"/>

        <StackPanel Visibility="{Binding IsNPointSplineSelected, Converter={StaticResource BoolToVis}}"
                    Margin="0,6,0,0">
            <StackPanel Orientation="Horizontal" Margin="5,0,0,4">
                <Label Content="Choose a Method:" FontWeight="Bold"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="10,0,0,6">
                <RadioButton Content="Catmull-Rom"
                             Style="{StaticResource CheckBoxRadioButton}"
                             GroupName="SplineAlgorithm"
                             IsChecked="{Binding IsCatmullRomSelected, Mode=TwoWay}"
                             Margin="0,0,12,0"/>
                <RadioButton Content="Bézier"
                             Style="{StaticResource CheckBoxRadioButton}"
                             GroupName="SplineAlgorithm"
                             IsChecked="{Binding IsBezierSelected, Mode=TwoWay}"/>
            </StackPanel>

            <Label Content="Output:" FontWeight="Bold" Margin="5,0,0,2"/>

            <Grid Margin="0,0,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto" MinWidth="42"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MinWidth="42"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Grid.Column="0" Content="Turn/Length:" Margin="5,0,8,4"/>
                <Label Grid.Row="0" Grid.Column="1" Content="{Binding TurningAngleArcRatioResult}" HorizontalContentAlignment="Left" Margin="0,0,0,4"/>
                <Label Grid.Row="0" Grid.Column="2" Content="Avg" Foreground="Gray" Margin="6,0,4,4"/>
                <Label Grid.Row="0" Grid.Column="3" Content="{Binding AvgTurningAngleArcRatioResult}" Margin="0,0,0,4"/>

                <Label Grid.Row="4" Grid.Column="0" Content="Chord-Arc Ratio:" Margin="5,0,8,4"/>
                <Label Grid.Row="4" Grid.Column="1" Content="{Binding SChordArcRatioResult}" HorizontalContentAlignment="Left" Margin="0,0,0,4"/>
                <Label Grid.Row="4" Grid.Column="2" Content="Avg" Foreground="Gray" Margin="6,0,4,4"/>
                <Label Grid.Row="4" Grid.Column="3" Content="{Binding AvgSChordArcRatioResult}" Margin="0,0,0,4"/>

                <Label Grid.Row="5" Grid.Column="0" Content="Length:" Margin="5,0,8,0"/>
                <Label Grid.Row="5" Grid.Column="1" Content="{Binding SplineLengthScaledResult}" HorizontalContentAlignment="Left"/>
                <Label Grid.Row="5" Grid.Column="2" Content="Avg" Foreground="Gray" Margin="6,0,4,0"/>
                <Label Grid.Row="5" Grid.Column="3" Content="{Binding AvgSplineLengthScaledResult}"/>
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                <CheckBox Content="Find Turning Angle / Length"
                          IsChecked="{Binding FindTurningAngleMode, Mode=TwoWay}"
                          VerticalAlignment="Center"/>
                <Label Content="{Binding FindTurningAngleDisplay}"
                       VerticalAlignment="Center"
                       Margin="8,0,0,0"/>
            </StackPanel>

            <StackPanel Margin="10,6,0,0"
                        Visibility="{Binding FindTurningAngleMode, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Section width:" Foreground="Gray" Margin="0,4,0,0"/>
                <Slider Minimum="1" Maximum="50"
                        Value="{Binding TurningAngleWindow, Mode=TwoWay}"
                        TickFrequency="1"
                        IsSnapToTickEnabled="True"
                        Margin="0,2,0,2"/>
                <TextBlock Text="{Binding TurningAngleWindow, StringFormat={}±{0} samples}"
                           Foreground="Gray"
                           Margin="0,0,0,4"/>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>