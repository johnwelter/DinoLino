<UserControl x:Class="DinoLino.Utilities.Modes.TriangleControlPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <StackPanel Orientation="Horizontal">
      <Label Content="Angle A:" FontWeight="Bold"/>
      <Label Content="{Binding AngleAResult}" Width="50" HorizontalContentAlignment="Left"/>
      <Label Content="Avg" Foreground="Gray"/>
      <Label Content="{Binding AvgAngleAResult}"/>
    </StackPanel>
    <StackPanel Orientation="Horizontal">
      <Label Content="Angle B:" FontWeight="Bold"/>
      <Label Content="{Binding AngleBResult}" Width="50" HorizontalContentAlignment="Left"/>
      <Label Content="Avg" Foreground="Gray"/>
      <Label Content="{Binding AvgAngleBResult}"/>
    </StackPanel>
    <StackPanel Orientation="Horizontal">
      <Label Content="Angle C:" FontWeight="Bold"/>
      <Label Content="{Binding AngleCResult}" Width="50" HorizontalContentAlignment="Left"/>
      <Label Content="Avg" Foreground="Gray"/>
      <Label Content="{Binding AvgAngleCResult}"/>
    </StackPanel>
    <StackPanel Orientation="Horizontal">
      <Label Content="Aspect Ratio:" FontWeight="Bold"/>
      <Label Content="{Binding TriAspectRatioResult}" Width="50" HorizontalContentAlignment="Left"/>
      <Label Content="Avg" Foreground="Gray"/>
      <Label Content="{Binding AvgTriAspectRatioResult}"/>
    </StackPanel>
    <StackPanel Orientation="Horizontal">
      <Label Content="Area:" FontWeight="Bold"/>
      <Label Content="{Binding TriAreaScaledResult}" Width="50" HorizontalContentAlignment="Left"/>
      <Label Content="Avg" Foreground="Gray"/>
      <Label Content="{Binding AvgTriAreaScaledResult}"/>
    </StackPanel>
    <StackPanel Orientation="Horizontal">
      <Label Content="Relative Size:" FontWeight="Bold"/>
      <Label Content="{Binding RelativeAreaResult}" Width="50" HorizontalContentAlignment="Left"/>
    </StackPanel>
  </StackPanel>
</UserControl>