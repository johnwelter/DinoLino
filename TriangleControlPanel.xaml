<UserControl x:Class="DinoLino.Utilities.Modes.TriangleControlPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="95"/>
      <!-- label -->
      <ColumnDefinition Width="55"/>
      <!-- value -->
      <ColumnDefinition Width="Auto"/>
      <!-- "Avg" -->
      <ColumnDefinition Width="Auto"/>
      <!-- average value -->
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Label Grid.Row="0" Grid.Column="0" Content="Angle A:" FontWeight="Bold"/>
    <Label Grid.Row="0" Grid.Column="1" Content="{Binding AngleAResult}" HorizontalContentAlignment="Left"/>
    <Label Grid.Row="0" Grid.Column="2" Content="Avg" Foreground="Gray"/>
    <Label Grid.Row="0" Grid.Column="3" Content="{Binding AvgAngleAResult}"/>

    <Label Grid.Row="1" Grid.Column="0" Content="Angle B:" FontWeight="Bold"/>
    <Label Grid.Row="1" Grid.Column="1" Content="{Binding AngleBResult}" HorizontalContentAlignment="Left"/>
    <Label Grid.Row="1" Grid.Column="2" Content="Avg" Foreground="Gray"/>
    <Label Grid.Row="1" Grid.Column="3" Content="{Binding AvgAngleBResult}"/>

    <Label Grid.Row="2" Grid.Column="0" Content="Angle C:" FontWeight="Bold"/>
    <Label Grid.Row="2" Grid.Column="1" Content="{Binding AngleCResult}" HorizontalContentAlignment="Left"/>
    <Label Grid.Row="2" Grid.Column="2" Content="Avg" Foreground="Gray"/>
    <Label Grid.Row="2" Grid.Column="3" Content="{Binding AvgAngleCResult}"/>

    <Label Grid.Row="3" Grid.Column="0" Content="Aspect Ratio:" FontWeight="Bold"/>
    <Label Grid.Row="3" Grid.Column="1" Content="{Binding TriAspectRatioResult}" HorizontalContentAlignment="Left"/>
    <Label Grid.Row="3" Grid.Column="2" Content="Avg" Foreground="Gray"/>
    <Label Grid.Row="3" Grid.Column="3" Content="{Binding AvgTriAspectRatioResult}"/>

    <Label Grid.Row="4" Grid.Column="0" Content="Area:" FontWeight="Bold"/>
    <Label Grid.Row="4" Grid.Column="1" Content="{Binding TriAreaScaledResult}" HorizontalContentAlignment="Left"/>
    <Label Grid.Row="4" Grid.Column="2" Content="Avg" Foreground="Gray"/>
    <Label Grid.Row="4" Grid.Column="3" Content="{Binding AvgTriAreaScaledResult}"/>

    <Label Grid.Row="5" Grid.Column="0" Content="Relative Size:" FontWeight="Bold"/>
    <Label Grid.Row="5" Grid.Column="1" Content="{Binding RelativeAreaResult}" HorizontalContentAlignment="Left"/>
  </Grid>
</UserControl>