<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:DinoLino"
    xmlns:System="clr-namespace:System;assembly=mscorlib" xmlns:core="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="DinoLino.MainWindow"
    mc:Ignorable="d"
    Title="DinoLino" Height="750" Width="1250"
    MinWidth="800" MinHeight="500"
    ResizeMode="CanResize"
    FontFamily="Arial">

    <DockPanel>

        <!-- 
            Menu Bar 
            - File
                - Open Image:   opens a selected image
            - Edit
                - Undo:         undoes last action
            - Help
                - About:        opens about window
        -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File" MouseLeave="Menu_MouseLeave">
                <MenuItem Header="_Open Image" Click="Menu_OpenImage" InputGestureText="Ctrl+F"/>
                <MenuItem Header="Open 3D _Model" Click="Menu_Open3DModel"/>
                <MenuItem Header="_Take Screenshot" Click="Menu_Screenshot" InputGestureText="Ctrl+S"/>
                <MenuItem Header="_Export Operation History" Click="Menu_ExportHistory" InputGestureText="Ctrl+E"/>
            </MenuItem>
            <MenuItem Header="_Edit" MouseLeave="Menu_MouseLeave">
                <MenuItem Header="_Undo" x:Name="UI_MenuUndo" Click="Menu_Undo"  InputGestureText="Ctrl+Z"/>
                <MenuItem Header="_Redo" x:Name="UI_MenuRedo" Click="Menu_Redo"  InputGestureText="Ctrl+Y"/>
            </MenuItem>
            <MenuItem Header="_Tools" MouseLeave="Menu_MouseLeave">
                <MenuItem Header="_Picture Corrections" Click="Menu_PictureAdjustment"/>
                <MenuItem Header="_Decimate" Click="Menu_DownSample"/>
                <MenuItem Header="_Flip">
                    <MenuItem Header="_Horizontal"  Click="Menu_FlipHorizontal"/>
                    <MenuItem Header="_Vertical"  Click="Menu_FlipVertical"/>
                </MenuItem>
                <MenuItem Header="_Rotate">
                    <MenuItem Header="_Rotate Right 90°"  Click="Menu_RotateRight"/>
                    <MenuItem Header="_Rotate Left 90°"  Click="Menu_RotateLeft"/>
                </MenuItem>
                <MenuItem Header="Reposition 3D _Object" x:Name="UI_MenuReposition3D"
                          Click="Menu_Reposition3DModel" IsEnabled="False"
                          ToolTip="Re-open the 3D model to rotate it and capture a new view. Available only for 3D objects."/>
            </MenuItem>
            <MenuItem Header="_View" MouseLeave="Menu_MouseLeave">
                <MenuItem Header="_See Tips" x:Name="UI_SeeTips" IsCheckable="True" IsChecked="True" Click="Menu_SeeTips"/>
                <MenuItem Header="_See Previous Operations" x:Name="UI_SeePrevOps" IsCheckable="True" IsChecked="False" Click="Menu_SeePrevOps" MouseLeave="Menu_MouseLeave"/>
                <MenuItem Header="_See Operation Count" x:Name="UI_SeeAttempts" IsCheckable="True" IsChecked="True" Click="Menu_SeeAttempts"/>
                <MenuItem Header="See _History" Click="Menu_SeeHistory"  InputGestureText="Ctrl+H"/>
                <MenuItem Header="_Line Color" x:Name="UI_LineColor" MouseLeave="Menu_MouseLeave">
                    <RadioButton Content="_Red" Tag="Red" GroupName="LineColors" IsChecked="True" Click="Menu_Color_Click"/>
                    <RadioButton Content="_Blue" Tag="Blue" GroupName="LineColors" Click="Menu_Color_Click"/>
                    <RadioButton Content="_Orange" Tag="Orange" GroupName="LineColors" Click="Menu_Color_Click"/>
                    <RadioButton Content="_Green" Tag="Green" GroupName="LineColors" Click="Menu_Color_Click"/>
                    <RadioButton Content="_Black" Tag="Black" GroupName="LineColors" Click="Menu_Color_Click"/>
                    <RadioButton Content="_Grey" Tag="Gray" GroupName="LineColors" Click="Menu_Color_Click"/>
                    <RadioButton Content="_White" Tag="White" GroupName="LineColors" Click="Menu_Color_Click"/>
                    <RadioButton Content="_Brown" Tag="Brown" GroupName="LineColors" Click="Menu_Color_Click"/>
                </MenuItem>
                <MenuItem Header="_Font" Click="Menu_Font"/>
            </MenuItem>
            <MenuItem Header="_Help" MouseLeave="Menu_MouseLeave">
                <MenuItem Header="_About" Click="Menu_About"/>
                <MenuItem Header="_User Guide" Click="Menu_UserGuide"/>
            </MenuItem>
        </Menu>

        <!-- 
            Main Program Window
            - Controls Panel
                - Global Controls
                - Mode tabs
                    - Curvature mode
                        - Curvature Mode controls
                        - Curvature Mode outputs
                            - Curvature angle output
                    - Angle mode
                    - Draw mode
            - Work Space
        -->
        <!-- Tips Bar -->
        <Border x:Name="UI_TipsBar"
        DockPanel.Dock="Bottom"
        Background="#1E1E1E"
        BorderBrush="#444"
        BorderThickness="0,1,0,0"
        MinHeight="28"
        Padding="10,4">
            <TextBlock x:Name="UI_TipText"
               Foreground="#CCCCCC"
               FontSize="14"
               VerticalAlignment="Center"
               TextWrapping="Wrap"/>
        </Border>
        <Grid x:Name="UI_MainWindow">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.28*" MinWidth="150" MaxWidth="550"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Controls Panel: toolbars and outputs for different controls and modes-->
            <StackPanel x:Name="UI_ControlPanel" Grid.Column="0" TextElement.FontSize="14">

                <!-- Controls that aren't dependent on mode type  -->
                <!-- Clears all added/Drawn UI from work space - might move this as a file or edit command with a keyboard shortcut -->
                <StackPanel x:Name="UI_GlobalControls" Orientation="Horizontal" Margin="10,10,10,5">
                    <TextBox x:Name="UI_SpecimenNameBox" MaxLength="20"
                             VerticalAlignment="Center"
                             MinWidth="100"/>
                    <StackPanel Orientation="Vertical" Margin="8,1,0,1">
                        <Button x:Name="UI_SpecimenUp" Content="▲" Width="22" Height="18"
                                Padding="0,-4,0,1" Click="SpecimenCount_Up"/>
                        <Button x:Name="UI_SpecimenDown" Content="▼" Width="22" Height="18"
                                Padding="-4" Click="SpecimenCount_Down"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock x:Name="UI_LoadedFileText"
                           Margin="10,0,10,5"
                           Foreground="#777"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding LoadedFileLabel}"/>

                <!-- Mode tabs -->
                <TabControl x:Name="UI_ControlTabs" Margin="0,10,0,10"
                            SelectionChanged="ControlTabs_SelectionChanged">
                    <TabItem Header="Curvature"/>
                    <TabItem Header="Triangle"/>
                    <TabItem Header="Draw"/>
                    <TabItem Header="Outline"/>
                </TabControl>
                <ContentControl x:Name="UI_ModePanel" Margin="0,0,0,10"/>
                <StackPanel Margin="10,-10,10,-5">
                    <Button x:Name="UI_ScaleButton" Content="Scale Image"
                            MinHeight="32" Click="GlobalTools_ScaleImage"/>
                    <TextBlock x:Name="UI_ScaleStatus"
                               Text="{Binding StatusText}"/>
                </StackPanel>
                <Button x:Name="UI_AAClearButton" Content="Clear All" Margin="10,10,10,10" MinHeight="32" VerticalAlignment="Top" Click="GlobalTools_Clear"/>
            </StackPanel>
            <GridSplitter Grid.Column="1"
                  Width="4"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  Background="DarkGray"
                  ResizeDirection="Columns"
                  ResizeBehavior="PreviousAndNext"
                  Cursor="SizeWE"/>
            <Grid x:Name="UI_WorkSpace" Grid.Column="2" ClipToBounds="True">
                <Grid MouseMove="WorkSpace_MouseMove" MouseDown="WorkSpace_Click" MouseUp="WorkSpace_MouseUp" MouseWheel="WorkSpace_ScrollZoom">
                    <Border x:Name ="UI_WorkBorder" BorderBrush="White" BorderThickness="3" Panel.ZIndex="10" Width="{Binding ActualWidth, ElementName=UI_WorkImage, Mode=OneWay}" Height="{Binding ActualHeight, ElementName=UI_WorkImage, Mode=OneWay}">
                        <Canvas x:Name="UI_WorkCanvas" Focusable="True"/>
                    </Border>
                    <Canvas x:Name="UI_WorkBackground" Background="Gray" />
                    <Image x:Name="UI_WorkImage"/>
                    <Grid x:Name="UI_ModelPoseOverlay" Visibility="Collapsed"
      MouseDown="ModelPose_MouseDown" MouseMove="ModelPose_MouseMove"
      MouseUp="ModelPose_MouseUp" MouseWheel="ModelPose_MouseWheel">

                        <!-- Opaque host: this is what gets rendered on capture, so the bitmap has a
         solid background (keeps JPEG-style consumers and outline contrast happy) -->
                        <Grid x:Name="UI_ModelViewportHost" Background="#FF3A3A3A">
                            <Viewport3D x:Name="UI_ModelViewport" IsHitTestVisible="False">
                                <Viewport3D.Camera>
                                    <OrthographicCamera x:Name="UI_ModelCamera"
                                    Position="0,0,10" LookDirection="0,0,-1"
                                    UpDirection="0,1,0" Width="10"/>
                                </Viewport3D.Camera>
                                <ModelVisual3D>
                                    <ModelVisual3D.Content>
                                        <Model3DGroup x:Name="UI_ModelGroup">
                                            <AmbientLight Color="#666666"/>
                                            <DirectionalLight Color="#B0B0B0" Direction="-0.3,-0.4,-1"/>
                                        </Model3DGroup>
                                    </ModelVisual3D.Content>
                                </ModelVisual3D>
                            </Viewport3D>
                        </Grid>

                        <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,12"
            Background="#CC202020" CornerRadius="6" Padding="10,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Foreground="White" VerticalAlignment="Center"
                       Text="Press scroll-wheel or arrow keys to rotate  •  Wheel to zoom"/>
                                <Button Content="Capture View" Margin="14,0,0,0" Padding="10,3" Click="ModelPose_Capture"/>
                                <Button Content="Cancel" Margin="8,0,0,0" Padding="10,3" Click="ModelPose_Cancel"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- Busy indicator: bottom-left, shown only while an outline
                     operation is running (see OutlineMode.BusyChanged). The
                     hourglass glyph counter-rotates continuously via an
                     indefinite storyboard that runs only while visible. -->
                <Border x:Name="UI_BusyIndicator"
                    HorizontalAlignment="Left" VerticalAlignment="Bottom"
                    Margin="16,0,0,16" Panel.ZIndex="60"
                    Background="#CC1E1E1E" BorderBrush="#666" BorderThickness="1"
                    CornerRadius="4" Padding="10,8" Visibility="Collapsed"
                    IsHitTestVisible="False">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="UI_BusyGlyph" Text="&#x231B;"
                            FontSize="40" Foreground="#EEE" VerticalAlignment="Center"
                            RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <RotateTransform x:Name="UI_BusyGlyphRotate" Angle="0"/>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                        <TextBlock Text="Working…" Margin="8,0,0,0"
                            FontSize="22" Foreground="#EEE" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Border.Triggers>
                        <EventTrigger RoutedEvent="Border.Loaded">
                            <BeginStoryboard>
                                <Storyboard x:Name="UI_BusySpin" RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetName="UI_BusyGlyphRotate"
                                        Storyboard.TargetProperty="Angle"
                                        From="0" To="360" Duration="0:0:4"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Border.Triggers>
                </Border>

                <!-- Attempt counter overlay (draggable HUD, bottom-right by default) -->
                <Border x:Name="UI_AttemptCounter"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,16,16" Panel.ZIndex="50"
                    Background="#CC1E1E1E" BorderBrush="#666" BorderThickness="1"
                    CornerRadius="4" Padding="10,8" Cursor="SizeAll"
                    MouseLeftButtonDown="AttemptCounter_MouseDown"
                    MouseMove="AttemptCounter_MouseMove"
                    MouseLeftButtonUp="AttemptCounter_MouseUp">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="UI_AttemptCounterTransform"/>
                    </Border.RenderTransform>
                    <StackPanel>
                        <TextBlock x:Name="UI_AttemptHeader" Text="Operation Count" Foreground="#999" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
                        <TextBlock x:Name="UI_AttemptCirc"   Foreground="#EEE" FontSize="12" Margin="0,1"/>
                        <TextBlock x:Name="UI_AttemptPara"   Foreground="#EEE" FontSize="12" Margin="0,1"/>
                        <TextBlock x:Name="UI_AttemptSpline" Foreground="#EEE" FontSize="12" Margin="0,1"/>
                        <TextBlock x:Name="UI_AttemptAngle"  Foreground="#EEE" FontSize="12" Margin="0,1"/>
                        <TextBlock x:Name="UI_AttemptLine"    Foreground="#EEE" FontSize="12" Margin="0,1"/>
                        <TextBlock x:Name="UI_AttemptOutline" Foreground="#EEE" FontSize="12" Margin="0,1"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
