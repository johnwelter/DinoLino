<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:DinoLino"
    xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
    xmlns:System="clr-namespace:System;assembly=mscorlib" xmlns:core="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="DinoLino.MainWindow"
    mc:Ignorable="d"
    Title="DinoLino" Height="750" Width="1514"
    MinWidth="800" MinHeight="500"
    ResizeMode="CanResize"
    FontFamily="Arial">

    <DockPanel>

        <!-- 
            Menu Bar 
            - File
                - Open Image:   opens a selected image
            - Edit
                - Undo:         undoes last action
            - Help
                - About:        opens about window
        -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File" MouseLeave="Menu_MouseLeave">
                <MenuItem Header="_Open Image" Click="Menu_OpenImage" InputGestureText="Ctrl+F"/>
                <MenuItem Header="Open 3D _Model" Click="Menu_Open3DModel"/>
                <MenuItem Header="_Take Screenshot" Click="Menu_Screenshot" InputGestureText="Ctrl+S"/>
                <MenuItem Header="_Export Operation History" Click="Menu_ExportHistory" InputGestureText="Ctrl+E"/>
            </MenuItem>
            <MenuItem Header="_Edit" MouseLeave="Menu_MouseLeave">
                <MenuItem Header="_Undo" x:Name="UI_MenuUndo" Click="Menu_Undo"  InputGestureText="Ctrl+Z"/>
                <MenuItem Header="_Redo" x:Name="UI_MenuRedo" Click="Menu_Redo"  InputGestureText="Ctrl+Y"/>
            </MenuItem>
            <MenuItem Header="_Tools" MouseLeave="Menu_MouseLeave">
                <MenuItem Header="_Set Scale" Click="Menu_SetScale"
                          ToolTip="Calibrate measurements: click both ends of a feature of known length, then enter that length."/>
                <MenuItem Header="_Picture Corrections" Click="Menu_PictureAdjustment"
                          ToolTip="Adjust picture properties such as brightness, contrast, and saturation."/>
                <MenuItem Header="_Decimate" Click="Menu_DownSample"/>
                <MenuItem Header="_Flip">
                    <MenuItem Header="_Horizontal"  Click="Menu_FlipHorizontal"/>
                    <MenuItem Header="_Vertical"  Click="Menu_FlipVertical"/>
                </MenuItem>
                <MenuItem Header="_Rotate">
                    <MenuItem Header="_Rotate Right 90°"  Click="Menu_RotateRight"/>
                    <MenuItem Header="_Rotate Left 90°"  Click="Menu_RotateLeft"/>
                </MenuItem>
                <MenuItem Header="Reposition 3D _Object" x:Name="UI_MenuReposition3D"
                          Click="Menu_Reposition3DModel" IsEnabled="False"
                          ToolTip="Re-open the 3D model to rotate it and capture a new view. Available only for 3D objects."/>
                <MenuItem Header="_Clear Image Cache" Click="Menu_ClearImageCache"
                          ToolTip="Remove all cached specimen images from the cache. Names and measurements are kept."/>
                <MenuItem Header="Edit _Image Cache" Click="Menu_EditImageCache"
                          ToolTip="Review cached specimen images and remove them one at a time."/>
            </MenuItem>
            <MenuItem Header="_View" MouseLeave="Menu_MouseLeave">
                <MenuItem Header="_See Tips" x:Name="UI_SeeTips" IsCheckable="True" IsChecked="True" Click="Menu_SeeTips"/>
                <MenuItem Header="_See Previous Operations" x:Name="UI_SeePrevOps" IsCheckable="True" IsChecked="False" Click="Menu_SeePrevOps" MouseLeave="Menu_MouseLeave"
                          ToolTip="Keep all previously drawn operations on screen until cleared."/>
                <MenuItem Header="_See Operation Count" x:Name="UI_SeeAttempts" IsCheckable="True" IsChecked="True" Click="Menu_SeeAttempts"
                          ToolTip="Display the number of operations performed for each specimen."/>
                <MenuItem Header="See _Navigation Window" x:Name="UI_SeeMiniMap" IsCheckable="True" IsChecked="False" Click="Menu_SeeMiniMap"
                          ToolTip="Show a draggable overview of the whole image. Click a spot on it to pan the zoomed view there."/>
                <MenuItem Header="See _Batch Workshop" x:Name="UI_SeeWorkshop" IsCheckable="True" IsChecked="True" Click="Menu_SeeWorkshop"
                          ToolTip="Show the Batch Workshop sidebar for batch exporting data."/>
                <MenuItem Header="See _Directory" x:Name="UI_SeeDirectory" IsCheckable="True" IsChecked="True" Click="Menu_SeeDirectory"
                          ToolTip="Show the Directory browser for setting the working directory and opening files."/>
                <MenuItem Header="See _Rex" x:Name="UI_SeeRex" IsCheckable="True" IsChecked="True" Click="Menu_SeeRex"
                          ToolTip="Show the creature artwork in the control panel."/>
                <MenuItem Header="See _History" Click="Menu_SeeHistory"  InputGestureText="Ctrl+H"/>
                <MenuItem Header="_Line Color" x:Name="UI_LineColor" MouseLeave="Menu_MouseLeave">
                    <RadioButton Content="_Red" Tag="Red" GroupName="LineColors" IsChecked="True" Click="Menu_Color_Click"/>
                    <RadioButton Content="_Blue" Tag="Blue" GroupName="LineColors" Click="Menu_Color_Click"/>
                    <RadioButton Content="_Orange" Tag="Orange" GroupName="LineColors" Click="Menu_Color_Click"/>
                    <RadioButton Content="_Green" Tag="Green" GroupName="LineColors" Click="Menu_Color_Click"/>
                    <RadioButton Content="_Black" Tag="Black" GroupName="LineColors" Click="Menu_Color_Click"/>
                    <RadioButton Content="_Grey" Tag="Gray" GroupName="LineColors" Click="Menu_Color_Click"/>
                    <RadioButton Content="_White" Tag="White" GroupName="LineColors" Click="Menu_Color_Click"/>
                    <RadioButton Content="_Brown" Tag="Brown" GroupName="LineColors" Click="Menu_Color_Click"/>
                </MenuItem>
                <MenuItem Header="_Font" Click="Menu_Font"/>
            </MenuItem>
            <MenuItem Header="_Help" MouseLeave="Menu_MouseLeave">
                <MenuItem Header="_About" Click="Menu_About"/>
                <MenuItem Header="_User Guide" Click="Menu_UserGuide"/>
            </MenuItem>
        </Menu>

        <!-- 
            Main Program Window
            - Controls Panel
                - Global Controls
                - Mode tabs
                    - Curvature mode
                        - Curvature Mode controls
                        - Curvature Mode outputs
                            - Curvature angle output
                    - Angle mode
                    - Draw mode
            - Work Space
        -->
        <!-- Tips Bar -->
        <Border x:Name="UI_TipsBar"
        DockPanel.Dock="Bottom"
        Background="#1E1E1E"
        BorderBrush="#444"
        BorderThickness="0,1,0,0"
        MinHeight="28"
        Padding="10,4">
            <TextBlock x:Name="UI_TipText"
               Foreground="#CCCCCC"
               FontSize="14"
               VerticalAlignment="Center"
               TextWrapping="Wrap"/>
        </Border>
        <Grid x:Name="UI_MainWindow">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.28*" MinWidth="150" MaxWidth="550"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
                <!-- Sidebar splitter and column: both collapse to zero width when
                     both sidebar panels are toggled off in the View menu. -->
                <ColumnDefinition x:Name="UI_SidebarSplitterColumn" Width="4"/>
                <ColumnDefinition x:Name="UI_SidebarColumn" Width="260" MinWidth="180" MaxWidth="500"/>
            </Grid.ColumnDefinitions>

            <!-- Controls Panel: toolbars and outputs for different controls and modes-->
            <StackPanel x:Name="UI_ControlPanel" Grid.Column="0" TextElement.FontSize="14">
                <!-- Controls that aren't dependent on mode type  -->
                <!-- Clears all added/Drawn UI from work space - might move this as a file or edit command with a keyboard shortcut -->
                <StackPanel x:Name="UI_GlobalControls" Orientation="Horizontal" Margin="10,10,10,5">
                    <TextBox x:Name="UI_SpecimenNameBox" MaxLength="20"
                             VerticalAlignment="Center"
                             MinWidth="100"/>
                    <StackPanel Orientation="Vertical" Margin="8,1,0,1">
                        <Button x:Name="UI_SpecimenUp" Content="▲" Width="22" Height="18"
                                Padding="0,-4,0,1" Click="SpecimenCount_Up"/>
                        <Button x:Name="UI_SpecimenDown" Content="▼" Width="22" Height="18"
                                Padding="-4" Click="SpecimenCount_Down"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock x:Name="UI_LoadedFileText"
                           Margin="10,0,10,5"
                           Foreground="#777"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding LoadedFileLabel}"/>

                <!-- Mode tabs -->
                <TabControl x:Name="UI_ControlTabs" Margin="0,10,0,10"
                            SelectionChanged="ControlTabs_SelectionChanged">
                    <TabItem Header="Curvature"/>
                    <TabItem Header="Triangle"/>
                    <TabItem Header="Draw"/>
                    <TabItem Header="Outline"/>
                </TabControl>
                <ContentControl x:Name="UI_ModePanel" Margin="0,0,0,10"/>
                <StackPanel Margin="10,0,10,-5">
                    <TextBlock x:Name="UI_ScaleStatus"
                               Text="{Binding StatusText}"/>
                </StackPanel>
                <Button x:Name="UI_AAClearButton" Content="Clear All" Margin="10,10,10,10" MinHeight="32" VerticalAlignment="Top" Click="GlobalTools_Clear"/>
                <!-- Creature art: the 1:2:1 columns make the middle column exactly half
                     the control panel's width, so the artwork is half size and centred
                     without any hard-coded margins. Toggled from View ▸ See Rex. -->
                <Grid x:Name="UI_CreatureArtContainer">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <svgc:SvgViewbox Grid.Column="1" Source="Icons/FullCreature.svg" Margin="0,10,0,10"/>
                </Grid>
            </StackPanel>
            <GridSplitter Grid.Column="1"
                  Width="4"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  Background="DarkGray"
                  ResizeDirection="Columns"
                  ResizeBehavior="PreviousAndNext"
                  Cursor="SizeWE"/>
            <!-- Workspace area: the viewport itself plus its navigation scrollbars -->
            <Grid x:Name="UI_WorkArea" Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid x:Name="UI_WorkSpace" Grid.Row="0" Grid.Column="0" ClipToBounds="True">
                    <Grid MouseMove="WorkSpace_MouseMove" MouseDown="WorkSpace_Click" MouseUp="WorkSpace_MouseUp" MouseWheel="WorkSpace_ScrollZoom">
                        <Border x:Name ="UI_WorkBorder" BorderBrush="White" BorderThickness="3" Panel.ZIndex="10" Width="{Binding ActualWidth, ElementName=UI_WorkImage, Mode=OneWay}" Height="{Binding ActualHeight, ElementName=UI_WorkImage, Mode=OneWay}">
                            <Canvas x:Name="UI_WorkCanvas" Focusable="True"/>
                        </Border>
                        <Canvas x:Name="UI_WorkBackground" Background="Gray" />
                        <Image x:Name="UI_WorkImage"/>
                        <Grid x:Name="UI_ModelPoseOverlay" Visibility="Collapsed"
      MouseDown="ModelPose_MouseDown" MouseMove="ModelPose_MouseMove"
      MouseUp="ModelPose_MouseUp" MouseWheel="ModelPose_MouseWheel">

                            <!-- Opaque host: this is what gets rendered on capture, so the bitmap has a
         solid background (keeps JPEG-style consumers and outline contrast happy) -->
                            <Grid x:Name="UI_ModelViewportHost" Background="#FF3A3A3A">
                                <Viewport3D x:Name="UI_ModelViewport" IsHitTestVisible="False">
                                    <Viewport3D.Camera>
                                        <OrthographicCamera x:Name="UI_ModelCamera"
                                    Position="0,0,10" LookDirection="0,0,-1"
                                    UpDirection="0,1,0" Width="10"/>
                                    </Viewport3D.Camera>
                                    <ModelVisual3D>
                                        <ModelVisual3D.Content>
                                            <Model3DGroup x:Name="UI_ModelGroup">
                                                <AmbientLight Color="#666666"/>
                                                <DirectionalLight Color="#B0B0B0" Direction="-0.3,-0.4,-1"/>
                                            </Model3DGroup>
                                        </ModelVisual3D.Content>
                                    </ModelVisual3D>
                                </Viewport3D>
                            </Grid>

                            <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,12"
            Background="#CC202020" CornerRadius="6" Padding="10,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Foreground="White" VerticalAlignment="Center"
                       Text="Press scroll-wheel or arrow keys to rotate  •  Wheel to zoom"/>
                                    <Button Content="Capture View" Margin="14,0,0,0" Padding="10,3" Click="ModelPose_Capture"/>
                                    <Button Content="Cancel" Margin="8,0,0,0" Padding="10,3" Click="ModelPose_Cancel"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- Busy indicator: bottom-left, shown only while an outline
                     operation is running (see OutlineMode.BusyChanged). The
                     hourglass glyph counter-rotates continuously via an
                     indefinite storyboard that runs only while visible. -->
                    <Border x:Name="UI_BusyIndicator"
                    HorizontalAlignment="Left" VerticalAlignment="Bottom"
                    Margin="16,0,0,16" Panel.ZIndex="60"
                    Background="#CC1E1E1E" BorderBrush="#666" BorderThickness="1"
                    CornerRadius="4" Padding="10,8" Visibility="Collapsed"
                    IsHitTestVisible="False">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="UI_BusyGlyph" Text="&#x231B;"
                            FontSize="30" Foreground="#EEE" VerticalAlignment="Center"
                            RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform>
                                    <RotateTransform x:Name="UI_BusyGlyphRotate" Angle="0"/>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                            <TextBlock Text="Working…" Margin="8,0,0,0"
                            FontSize="20" Foreground="#EEE" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border.Triggers>
                            <EventTrigger RoutedEvent="Border.Loaded">
                                <BeginStoryboard>
                                    <Storyboard x:Name="UI_BusySpin" RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="UI_BusyGlyphRotate"
                                        Storyboard.TargetProperty="Angle"
                                        From="0" To="360" Duration="0:0:4"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Border.Triggers>
                    </Border>

                    <!-- Attempt counter overlay (draggable HUD, bottom-right by default) -->
                    <Border x:Name="UI_AttemptCounter"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,16,16" Panel.ZIndex="50"
                    Background="#CC1E1E1E" BorderBrush="#666" BorderThickness="1"
                    CornerRadius="4" Padding="10,8" Cursor="SizeAll"
                    MouseLeftButtonDown="AttemptCounter_MouseDown"
                    MouseMove="AttemptCounter_MouseMove"
                    MouseLeftButtonUp="AttemptCounter_MouseUp">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="UI_AttemptCounterTransform"/>
                        </Border.RenderTransform>
                        <StackPanel>
                            <TextBlock x:Name="UI_AttemptHeader" Text="Operation Count" Foreground="#999" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBlock x:Name="UI_AttemptCirc"   Foreground="#EEE" FontSize="12" Margin="0,1"/>
                            <TextBlock x:Name="UI_AttemptPara"   Foreground="#EEE" FontSize="12" Margin="0,1"/>
                            <TextBlock x:Name="UI_AttemptSpline" Foreground="#EEE" FontSize="12" Margin="0,1"/>
                            <TextBlock x:Name="UI_AttemptAngle"  Foreground="#EEE" FontSize="12" Margin="0,1"/>
                            <TextBlock x:Name="UI_AttemptLine"    Foreground="#EEE" FontSize="12" Margin="0,1"/>
                            <TextBlock x:Name="UI_AttemptOutline" Foreground="#EEE" FontSize="12" Margin="0,1"/>
                        </StackPanel>
                    </Border>

                    <!-- Navigation window overlay: draggable, resizable overview of the whole image
                     (View ▸ See Navigation Window). Clicking or dragging on the picture pans the
                     zoomed workspace view to that spot. -->
                    <Border x:Name="UI_MiniMap" Panel.ZIndex="70"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    Margin="16,16,0,0" Width="230" Height="185"
                    MinWidth="140" MinHeight="110"
                    Background="#CC1E1E1E" BorderBrush="#666" BorderThickness="1"
                    CornerRadius="4" Visibility="Collapsed">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="UI_MiniMapTranslate"/>
                        </Border.RenderTransform>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Title bar doubles as the drag handle -->
                            <Border Grid.Row="0" Background="#CC2B2B2B" CornerRadius="3,3,0,0" Cursor="SizeAll"
                            MouseLeftButtonDown="MiniMapTitleBar_MouseDown"
                            MouseMove="MiniMapTitleBar_MouseMove"
                            MouseLeftButtonUp="MiniMapTitleBar_MouseUp">
                                <DockPanel Margin="6,2,2,2">
                                    <Button DockPanel.Dock="Right" Content="✕" Width="18" Height="18"
                                    Padding="0" FontSize="10" Background="Transparent" Foreground="#CCC"
                                    BorderThickness="0" Cursor="Arrow" Click="MiniMapClose_Click"
                                    ToolTip="Hide the navigation window"/>
                                    <TextBlock Text="Navigation Window" Foreground="#BBB" FontSize="11" FontWeight="Bold"
                                    VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>

                            <!-- Map area: low-res copy of the image plus the current-view rectangle -->
                            <Grid Grid.Row="1" x:Name="UI_MiniMapArea" Margin="5" Background="#33000000"
                            ClipToBounds="True"
                            MouseLeftButtonDown="MiniMapArea_MouseDown"
                            MouseMove="MiniMapArea_MouseMove"
                            MouseLeftButtonUp="MiniMapArea_MouseUp">
                                <Image x:Name="UI_MiniMapImage" Stretch="Uniform"
                                RenderOptions.BitmapScalingMode="LowQuality"/>
                                <Canvas x:Name="UI_MiniMapOverlay" IsHitTestVisible="False">
                                    <Rectangle x:Name="UI_MiniMapViewRect" Stroke="OrangeRed" StrokeThickness="1.5"
                                    Fill="#28FF4500" Visibility="Collapsed"/>
                                </Canvas>
                            </Grid>

                            <!-- Resize grip -->
                            <Thumb x:Name="UI_MiniMapResizeGrip" Grid.Row="1" Width="14" Height="14"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Cursor="SizeNWSE" DragDelta="MiniMapResizeGrip_DragDelta">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Grid Background="Transparent">
                                            <Path Data="M 12,2 L 2,12 M 12,7 L 7,12" Stroke="#999" StrokeThickness="1.5"/>
                                        </Grid>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Navigation scrollbars: enabled whenever the zoomed image extends
                     beyond the viewport on that axis -->
                <ScrollBar x:Name="UI_VScrollBar" Grid.Row="0" Grid.Column="1"
                    Orientation="Vertical" Width="16"
                    Minimum="0" Maximum="0" IsEnabled="False"
                    ValueChanged="WorkSpaceScrollBar_ValueChanged"/>
                <ScrollBar x:Name="UI_HScrollBar" Grid.Row="1" Grid.Column="0"
                    Orientation="Horizontal" Height="16"
                    Minimum="0" Maximum="0" IsEnabled="False"
                    ValueChanged="WorkSpaceScrollBar_ValueChanged"/>
            </Grid>

            <!-- Sidebar resize handle -->
            <GridSplitter x:Name="UI_SidebarSplitter" Grid.Column="3"
                  Width="4"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  Background="DarkGray"
                  ResizeDirection="Columns"
                  ResizeBehavior="PreviousAndNext"
                  Cursor="SizeWE"/>

            <!-- Right sidebar: Batch Workshop on top, Directory below, each toggled
                 independently in the View menu. Row heights are set by
                 UpdateSidebarLayout in MainWindow_Workshop.cs; the whole column
                 collapses when both panels are hidden. -->
            <Grid x:Name="UI_Sidebar" Grid.Column="4">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="UI_WorkshopRow" Height="Auto"/>
                    <RowDefinition x:Name="UI_SidebarDividerRow" Height="Auto"/>
                    <RowDefinition x:Name="UI_DirectoryRow" Height="*"/>
                </Grid.RowDefinitions>

                <!-- Batch Workshop: per-category export for every specimen in the
                 session. Toggled from View ▸ See Batch Workshop. -->
                <DockPanel x:Name="UI_WorkshopPanel" Grid.Row="0" TextElement.FontSize="14" Margin="8,10,8,10">
                    <TextBlock DockPanel.Dock="Top" Text="Batch Workshop"
                           FontWeight="Bold" FontSize="16"
                           HorizontalAlignment="Left" Margin="2,0,0,2"/>
                    <TextBlock DockPanel.Dock="Top" Text="Export measurements for all specimens."
                           Foreground="#777" TextWrapping="Wrap"
                           HorizontalAlignment="Left" Margin="2,0,0,8"/>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              VerticalAlignment="Top" MaxHeight="340">
                        <StackPanel>
                            <!-- Each row: left-aligned label, then an edit and an export
                             button on the right. The shared styles keep every row on
                             the same grid and glyph size. -->
                            <StackPanel.Resources>
                                <Style x:Key="WorkshopRowLabel" TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Left"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                    <Setter Property="Margin" Value="2,0,8,0"/>
                                </Style>
                                <!-- Shared look for both glyph buttons. Segoe UI Emoji is set
                                 explicitly so the symbols render as emoji rather than
                                 falling back to a text glyph or a missing-character box. -->
                                <Style x:Key="WorkshopGlyphButton" TargetType="Button">
                                    <Setter Property="Width" Value="26"/>
                                    <Setter Property="Height" Value="26"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="FontFamily" Value="Segoe UI Emoji"/>
                                    <Setter Property="FontSize" Value="13"/>
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <!-- Show the tooltip at the cursor rather than below the button. -->
                                    <Setter Property="ToolTipService.Placement" Value="Mouse"/>
                                    <Setter Property="ToolTipService.InitialShowDelay" Value="150"/>
                                    <Setter Property="ToolTipService.ShowDuration" Value="20000"/>
                                </Style>
                                <Style x:Key="WorkshopEditButton" TargetType="Button" BasedOn="{StaticResource WorkshopGlyphButton}">
                                    <Setter Property="Content" Value="&#x270F;&#xFE0F;"/>
                                    <Setter Property="ToolTip" Value="Edit"/>
                                    <Setter Property="Margin" Value="0,0,6,0"/>
                                </Style>
                                <Style x:Key="WorkshopExportButton" TargetType="Button" BasedOn="{StaticResource WorkshopGlyphButton}">
                                    <Setter Property="Content" Value="&#x1F4E4;"/>
                                    <Setter Property="ToolTip" Value="Export"/>
                                </Style>
                                <Style x:Key="WorkshopRow" TargetType="Grid">
                                    <Setter Property="Margin" Value="0,0,0,10"/>
                                </Style>
                            </StackPanel.Resources>

                            <Grid Style="{StaticResource WorkshopRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Curvature Data" Style="{StaticResource WorkshopRowLabel}"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button x:Name="UI_EditCurvature" Style="{StaticResource WorkshopEditButton}"
                                        Click="Workshop_EditCurvature"/>
                                    <Button Style="{StaticResource WorkshopExportButton}"
                                        Click="Workshop_ExportCurvature"/>
                                </StackPanel>
                            </Grid>

                            <Grid Style="{StaticResource WorkshopRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Angle Data" Style="{StaticResource WorkshopRowLabel}"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button x:Name="UI_EditAngle" Style="{StaticResource WorkshopEditButton}"
                                        Click="Workshop_EditAngle"/>
                                    <Button Style="{StaticResource WorkshopExportButton}"
                                        Click="Workshop_ExportAngle"/>
                                </StackPanel>
                            </Grid>

                            <Grid Style="{StaticResource WorkshopRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Shape Data" Style="{StaticResource WorkshopRowLabel}"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button x:Name="UI_EditShape" Style="{StaticResource WorkshopEditButton}"
                                        Click="Workshop_EditShape"/>
                                    <Button Style="{StaticResource WorkshopExportButton}"
                                        Click="Workshop_ExportShape"/>
                                </StackPanel>
                            </Grid>

                            <Grid Style="{StaticResource WorkshopRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Outline Metadata" Style="{StaticResource WorkshopRowLabel}"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button x:Name="UI_EditOutline" Style="{StaticResource WorkshopEditButton}"
                                        Click="Workshop_EditOutline"/>
                                    <Button Style="{StaticResource WorkshopExportButton}"
                                        Click="Workshop_ExportOutline"/>
                                </StackPanel>
                            </Grid>

                            <Grid Style="{StaticResource WorkshopRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="EFA Data" Style="{StaticResource WorkshopRowLabel}"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button x:Name="UI_EditEfa" Style="{StaticResource WorkshopEditButton}"
                                        Click="Workshop_EditEfa"/>
                                    <Button Style="{StaticResource WorkshopExportButton}"
                                        Click="Workshop_ExportEfa"/>
                                </StackPanel>
                            </Grid>

                            <Grid Style="{StaticResource WorkshopRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="2D Outlines" Style="{StaticResource WorkshopRowLabel}"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button x:Name="UI_Edit2DOutlines" Style="{StaticResource WorkshopEditButton}"
                                        Click="Workshop_Edit2DOutlines"/>
                                    <Button Style="{StaticResource WorkshopExportButton}"
                                        Click="Workshop_Export2DOutlines"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>

                <!-- Thin rule between the two panels, shown only when both are visible -->
                <Border x:Name="UI_SidebarDivider" Grid.Row="1" Height="1"
                    Background="#CCCCCC"/>

                <!-- Directory: file browser for setting the working directory and opening
                 images and 3D models. Logic lives in MainWindow_Directory.cs. -->
                <DockPanel x:Name="UI_DirectoryPanel" Grid.Row="2" TextElement.FontSize="14"
                       Margin="8,10,8,10">
                    <TextBlock DockPanel.Dock="Top" Text="Directory"
                           FontWeight="Bold" FontSize="16"
                           HorizontalAlignment="Left" Margin="2,0,0,2"/>

                    <!-- Paste or type a path here and press Enter, or use Go. -->
                    <DockPanel DockPanel.Dock="Top" Margin="2,0,0,4">
                        <Button DockPanel.Dock="Right" Content="Go"
                            Padding="8,1" Margin="4,0,0,0" Click="Directory_ApplyTypedPath"
                            ToolTip="Set the working directory to the path shown"/>
                        <TextBox x:Name="UI_WorkingDirectoryBox"
                             VerticalContentAlignment="Center"
                             KeyDown="Directory_PathBoxKeyDown"
                             ToolTip="Paste or type a folder path, then press Enter"/>
                    </DockPanel>

                    <DockPanel DockPanel.Dock="Top" Margin="2,0,0,6">
                        <Button DockPanel.Dock="Right" Content="Drives"
                            Padding="8,1" Margin="6,0,0,0" Click="Directory_ShowDrives"
                            ToolTip="Browse all drives again"/>
                        <TextBlock x:Name="UI_WorkingDirectoryText"
                               Foreground="#777" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Text="Working directory: not set"/>
                    </DockPanel>

                    <!-- The TreeView supplies its own scrollbars for content that does not
                     fit the panel. -->
                    <Border BorderBrush="#AAAAAA" BorderThickness="1" Background="White">
                        <TreeView x:Name="UI_DirectoryTree" BorderThickness="0"
                              Loaded="DirectoryTree_Loaded"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                    </Border>
                </DockPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
